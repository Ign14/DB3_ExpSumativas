<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>cl.duoc.bancoxyz</groupId>
    <artifactId>banco-xyz-microservicios</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>banco-xyz-microservicios</name>
    <description>
        Exp3 S6-S8 - Microservicios del Banco XYZ en la nube: configuracion
        centralizada, service discovery, OAuth2 con JWT, tolerancia a fallos
        con Resilience4j, mensajeria asincrona JMS y despliegue con Docker.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
    </properties>

    <modules>
        <module>common-events</module>
        <module>broker-artemis</module>
        <module>config-server</module>
        <module>discovery-server</module>
        <module>auth-server</module>
        <module>api-gateway</module>
        <module>cuentas-service</module>
        <module>movimientos-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>cl.duoc.bancoxyz</groupId>
                <artifactId>common-events</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
