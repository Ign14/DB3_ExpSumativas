
========== Configuracion que el Config Server entrega a cada microservicio ==========
--- cuentas-service
{
    "name": "cuentas-service",
    "profiles": [
        "default"
    ],
    "label": null,
    "version": null,
    "state": null,
    "propertySources": [
        {
            "name": "classpath:/configuracion-central/cuentas-service.yml",
            "source": {
                "server.port": 8081,
                "spring.security.oauth2.resourceserver.jwt.issuer-uri": "${AUTH_ISSUER_URI:http://localhost:9000}",
                "spring.security.oauth2.resourceserver.jwt.jwk-set-uri": "${AUTH_ISSUER_URI:http://localhost:9000}/oauth2/jwks",
                "spring.artemis.mode": "native",
                "spring.artemis.broker-url": "tcp://${ARTEMIS_HOST:localhost}:61616?callTimeout=4000&connectionTTL=30000",
                "spring.artemis.user": "${ARTEMIS_USER:artemis}",
                "spring.artemis.password": "${ARTEMIS_PASSWORD:artemis}",
                "banco.cuentas.limite-retiro-por-operacion": 500000
            }
        },
        {
            "name": "classpath:/configuracion-central/application.yml",
            "source": {
                "eureka.client.service-url.defaultZone": "http://${EUREKA_USER:banco-eureka}:${EUREKA_PASSWORD:banco-eureka-secret}@${EUREKA_HOST:localhost}:8761/eureka/",
                "eureka.client.register-with-eureka": true,
                "eureka.client.fetch-registry": true,
                "eureka.client.registry-fetch-interval-seconds": 5,
                "eureka.client.disable-delta": true,
                "eureka.instance.prefer-ip-address": true,
                "eureka.instance.lease-renewal-interval-in-seconds": 10,
                "management.endpoints.web.exposure.include": "health,info,circuitbreakers,circuitbreakerevents,retries,retryevents",
                "management.endpoint.health.show-details": "when-authorized",
                "management.endpoint.health.probes.enabled": true,
                "logging.level.root": "INFO",
                "logging.level.cl.duoc.bancoxyz": "INFO"
            }
        }
    ]
}
--- movimientos-service
{
    "name": "movimientos-service",
    "profiles": [
        "default"
    ],
    "label": null,
    "version": null,
    "state": null,
    "propertySources": [
        {
            "name": "classpath:/configuracion-central/movimientos-service.yml",
            "source": {
                "server.port": 8082,
                "spring.security.oauth2.resourceserver.jwt.issuer-uri": "${AUTH_ISSUER_URI:http://localhost:9000}",
                "spring.security.oauth2.resourceserver.jwt.jwk-set-uri": "${AUTH_ISSUER_URI:http://localhost:9000}/oauth2/jwks",
                "spring.security.oauth2.client.registration.cuentas-client.provider": "banco-auth",
                "spring.security.oauth2.client.registration.cuentas-client.client-id": "movimientos-service",
                "spring.security.oauth2.client.registration.cuentas-client.client-secret": "${MOVIMIENTOS_CLIENT_SECRET:movimientos-secret}",
                "spring.security.oauth2.client.registration.cuentas-client.authorization-grant-type": "client_credentials",
                "spring.security.oauth2.client.registration.cuentas-client.scope": "cuentas.read",
                "spring.security.oauth2.client.provider.banco-auth.token-uri": "${AUTH_ISSUER_URI:http://localhost:9000}/oauth2/token",
                "spring.artemis.mode": "native",
                "spring.artemis.broker-url": "tcp://${ARTEMIS_HOST:localhost}:61616?callTimeout=4000&connectionTTL=30000",
                "spring.artemis.user": "${ARTEMIS_USER:artemis}",
                "spring.artemis.password": "${ARTEMIS_PASSWORD:artemis}",
                "banco.cuentas-service.url": "http://${CUENTAS_HOST:localhost}:8081",
                "resilience4j.circuitbreaker.instances.cuentas.register-health-indicator": true,
                "resilience4j.circuitbreaker.instances.cuentas.event-consumer-buffer-size": 100,
                "resilience4j.circuitbreaker.instances.cuentas.sliding-window-type": "COUNT_BASED",
                "resilience4j.circuitbreaker.instances.cuentas.sliding-window-size": 10,
                "resilience4j.circuitbreaker.instances.cuentas.minimum-number-of-calls": 4,
                "resilience4j.circuitbreaker.instances.cuentas.failure-rate-threshold": 50,
                "resilience4j.circuitbreaker.instances.cuentas.wait-duration-in-open-state": "10s",
                "resilience4j.circuitbreaker.instances.cuentas.permitted-number-of-calls-in-half-open-state": 3,
                "resilience4j.circuitbreaker.instances.cuentas.automatic-transition-from-open-to-half-open-enabled": true,
                "resilience4j.circuitbreaker.instances.cuentas.record-exceptions[0]": "cl.duoc.bancoxyz.common.excepcion.ServicioNoDisponibleException",
                "resilience4j.circuitbreaker.instances.cuentas.record-exceptions[1]": "java.util.concurrent.TimeoutException",
                "resilience4j.retry.instances.cuentas.max-attempts": 2,
                "resilience4j.retry.instances.cuentas.wait-duration": "200ms",
                "resilience4j.retry.instances.cuentas.event-consumer-buffer-size": 100,
                "resilience4j.retry.instances.cuentas.retry-exceptions[0]": "cl.duoc.bancoxyz.common.excepcion.ServicioNoDisponibleException",
                "resilience4j.retry.instances.cuentas.retry-exceptions[1]": "java.util.concurrent.TimeoutException",
                "resilience4j.retry.instances.cuentas.ignore-exceptions[0]": "io.github.resilience4j.circuitbreaker.CallNotPermittedException",
                "resilience4j.retry.instances.cuentas.ignore-exceptions[1]": "cl.duoc.bancoxyz.common.excepcion.LlamadaRechazadaException",
                "resilience4j.timelimiter.instances.cuentas.timeout-duration": "2s",
                "resilience4j.timelimiter.instances.cuentas.cancel-running-future": true
            }
        },
        {
            "name": "classpath:/configuracion-central/application.yml",
            "source": {
                "eureka.client.service-url.defaultZone": "http://${EUREKA_USER:banco-eureka}:${EUREKA_PASSWORD:banco-eureka-secret}@${EUREKA_HOST:localhost}:8761/eureka/",
                "eureka.client.register-with-eureka": true,
                "eureka.client.fetch-registry": true,
                "eureka.client.registry-fetch-interval-seconds": 5,
                "eureka.client.disable-delta": true,
                "eureka.instance.prefer-ip-address": true,
                "eureka.instance.lease-renewal-interval-in-seconds": 10,
                "management.endpoints.web.exposure.include": "health,info,circuitbreakers,circuitbreakerevents,retries,retryevents",
                "management.endpoint.health.show-details": "when-authorized",
                "management.endpoint.health.probes.enabled": true,
                "logging.level.root": "INFO",
                "logging.level.cl.duoc.bancoxyz": "INFO"
            }
        }
    ]
}
