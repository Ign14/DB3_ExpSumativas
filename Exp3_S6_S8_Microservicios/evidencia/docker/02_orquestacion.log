========== La resolucion por nombre funciona dentro de la red ==========
Se consulta el Config Server desde dentro del contenedor del gateway, usando
el nombre de servicio como host. No hay IPs ni puertos escritos a mano.
$ docker compose exec -T api-gateway curl -s -u *** http://config-server:8888/api-gateway/default
{"name":"api-gateway","profiles":["default"],"label":null,"version":null,"state":null,"propertySources":[{"name":"classpath:/configuracion-central/api-gateway.yml","source":{"server.port":8080,"spring.security.oauth2.resourceserver.jwt.issuer-uri":"${AUTH_ISSUER_URI:http://localhost:9000}","spring.security.oauth2.resourceserver.jwt.jwk-set-uri":"${AUTH_ISSUER_URI:http://localhost:9000}/oauth2/jwks","spring.cloud.gateway.discovery.locator.enabled":false,"spring.cloud.gateway.routes[0].id":"cuentas-service","spring.cloud.gateway.routes[0].uri":"lb://cuentas-service","spring.cloud.gateway.routes[0].predicates[0]":"Path=/api/cuentas/**","spring.cloud.gateway.routes[0].filters[0]":"StripPrefix=1","spring.cloud.gateway.routes[1].id":"movimientos-service","spring.cloud.gateway.routes[1].uri":"lb://movimientos-service","spring.cloud.gateway.routes[1].predicates[0]":"Path=/api/movimientos/**","spring.cloud.gateway.routes[1].filters[0]":"StripPrefix=1"}},{"name":"classpath:/configuracion-central/application.yml","source":{"eureka.client.service-url.defaultZone":"http://${EUREKA_USER:banco-eureka}:${EUREKA_PASSWORD:banco-eureka-secret}@${EUREKA_HOST:localhost}:8761/eureka/","eureka.client.register-with-eureka":true,"eureka.client.fetch-registry":true,"eureka.client.registry-fetch-interval-seconds":5,"eureka.client.disable-delta":true,"eureka.instance.prefer-ip-address":true,"eureka.instance.lease-renewal-interval-in-seconds":10,"management.endpoints.web.exposure.include":"health,info,circuitbreakers,circuitbreakerevents,retries,retryevents","management.endpoint.health.show-details":"when-authorized","management.endpoint.health.probes.enabled":true,"logging.level.root":"INFO","logging.level.cl.duoc.bancoxyz":"INFO"}}]}

