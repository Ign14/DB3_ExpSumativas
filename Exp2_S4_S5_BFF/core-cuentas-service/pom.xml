<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cl.duoc.bancoxyz</groupId>
        <artifactId>banco-xyz-bff</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>core-cuentas-service</artifactId>
    <packaging>jar</packaging>
    <name>core-cuentas-service</name>
    <description>
        Servicio backend "core" que expone los datos maestros de cuentas
        (titular, tipo, saldo) a partir de intereses.csv del dataset legacy.
        No conoce a los BFF; solo expone una API de dominio.
    </description>

    <dependencies>
        <dependency>
            <groupId>cl.duoc.bancoxyz</groupId>
            <artifactId>common-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>core-cuentas-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
