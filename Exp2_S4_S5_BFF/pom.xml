<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>cl.duoc.bancoxyz</groupId>
    <artifactId>banco-xyz-bff</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>banco-xyz-bff</name>
    <description>
        Exp2 S4/S5 - Implementacion del patron arquitectonico Backend for Frontend (BFF)
        para el Banco XYZ: un backend dedicado por canal (web, movil, cajero) que agrega
        y transforma la informacion expuesta por dos servicios "core" de dominio.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>common-model</module>
        <module>core-cuentas-service</module>
        <module>core-movimientos-service</module>
        <module>bff-web</module>
        <module>bff-movil</module>
        <module>bff-cajero</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cl.duoc.bancoxyz</groupId>
                <artifactId>common-model</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
