<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level [%thread] %logger{36} : %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <!-- Baja el ruido de Hibernate/Spring en consola para que la evidencia de
         ejecución (estado de Jobs/Steps, resúmenes y anomalías) se lea con claridad -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.springframework.jdbc" level="WARN"/>
</configuration>
