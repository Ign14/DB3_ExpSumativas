]

--- Resumen del historial: GET /api/movimientos/101/resumen ---
{
    "cuentaId": 101,
    "totalMovimientos": 37,
    "totalDepositos": 20000,
    "totalEgresos": 51500,
    "ultimaFecha": "2024-12-19"
}

--- Reporte de transacciones diarias (salida del proceso batch 1) ---
{
    "cantidadTotal": 392,
    "montoTotal": 529400,
    "cantidadCreditos": 176,
    "cantidadDebitos": 216,
    "montoCreditos": 244500,
    "montoDebitos": 284900
}

--- Vista agregada con tolerancia a fallos: GET /api/movimientos/101/ficha ---
   origenDatosCuenta: SERVICIO
   cuenta: {"cuentaId": 101, "nombreTitular": "John Doe", "edad": 40, "tipoCuenta": "prestamo", "saldo": 5000}
   resumen: {"cuentaId": 101, "totalMovimientos": 37, "totalDepositos": 20000, "totalEgresos": 51500, "ultimaFecha": "2024-12-19"}
   movimientos en el historial: 37
