}

--- Intento de retiro sobre el limite: genera alerta, no transaccion ---
{
    "cuentaId": 101,
    "montoSolicitado": 900000,
    "saldoResultante": null,
    "aprobado": false,
    "motivoRechazo": "El monto supera el limite de 500000 por operacion.",
    "eventoId": null,
    "eventoPublicado": false
}

