--- Gestion de cuentas ---
{
    "cuentaId": 101,
    "nombreTitular": "John Doe",
    "edad": 40,
    "tipoCuenta": "prestamo",
    "saldo": 5000
}

--- Reporte de transacciones diarias (salida del proceso batch 1) ---
{
    "cantidadTotal": 392,
    "montoTotal": 529400,
    "cantidadCreditos": 176,
    "cantidadDebitos": 216,
    "montoCreditos": 244500,
    "montoDebitos": 284900
}

--- Estado antes del retiro ---
   saldo: 5000   movimientos: 37

--- Retiro por el canal cajero: viaja por la cola JMS entre dos contenedores ---
{
    "cuentaId": 101,
    "montoSolicitado": 250,
    "saldoResultante": 4750,
    "aprobado": true,
    "motivoRechazo": null,
    "eventoId": "c7faf689-65be-483b-8b86-003d5234a3b6",
    "eventoPublicado": true
}
   saldo:       5000 -> 4750   (bajo en cuentas-service)
   movimientos: 37 -> 38   (subio en pagos-service, por la cola)

